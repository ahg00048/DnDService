# MinIO
MINIO_HOST=minio-container
MINIO_PORT=9000
MINIO_SECURE=false
MINIO_ACCESS=minioadmin
MINIO_SECRET=minioadmin

# Redis
REDIS_HOST=redis-container
REDIS_PORT=6379

# MongoDB
MONGODB_HOST=mongo-container
MONGODB_PORT=27017
MONGODB_REPLICA=rs0
DB_USERNAME=admin
DB_PASSWORD=admin
DB_AUTH=admin

# RabbitMQ
RABBITMQ_HOST=rabbitmq-container
RABBITMQ_PORT=5672
RABBITMQ_PORT=61613
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# Keycloak
KEYCLOAK_HOST=keycloak-container

# Registry service
REGISTRY_HOST=registry-service-container